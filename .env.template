# ─────────────────────────────────────────────────────────────────────────────
# Velbaz — modèle de configuration.
#
# Copier en `.env` À LA RACINE (un seul fichier : jamais .env.local / .env.production).
# Les clés COMMENTÉES sont optionnelles : la fonctionnalité se désactive
# proprement si elles sont vides, elle ne simule jamais un résultat.
#
# [ADMIN] = à saisir plutôt depuis Admin Panel → API Keys (stockage chiffré en
#           base, prise en compte immédiate, aucun redémarrage). Pas besoin de
#           l'écrire ici.
# [ENV]   = lue seulement dans process.env → doit être ici + redémarrage.
#
# Détail de l'effet de chaque clé manquante : voir MIGRATION.md.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ REQUIS — l'app ne fonctionne pas sans ═══════════════════════════════════

# Environnement
NODE_ENV=development
WEBSITE_URL=http://localhost:4200
APPLICATION_ID=

# Better Auth — sessions / authentification
BETTER_AUTH_SECRET=

# Base de données (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Passerelle IA — tous les agents
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Paiements plateforme / suivi
AUTUMN_SECRET_KEY=

# Stockage fichiers (Tigris) — upload
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Fournis par Runable à l'import — NE PAS écrire en dur
VITE_RUNABLE_AUTH_ISSUER=
VITE_APPLICATION_ID=
RUNABLE_URL=

# ═══ RECOMMANDÉ EN PRODUCTION ════════════════════════════════════════════════

# [ENV] Clé de chiffrement du coffre de clés API. Repli : BETTER_AUTH_SECRET.
# SECRET_STORE_KEY=
# [ENV] Emails admin (séparés par des virgules). Contrôle l'accès aux pages admin.
# ADMIN_EMAILS=

# ═══ PAIEMENTS — Stripe (api/billing.ts) ═════════════════════════════════════
# Sans STRIPE_SECRET_KEY : aucun paiement réel, l'UI annonce que c'est non configuré.

# [ADMIN] STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# [ADMIN] Signature de /api/billing/webhook. Optionnel : la confirmation au
#         retour sur le site crédite le compte même sans lui.
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# ═══ DOMAINES PERSONNALISÉS (api/domains.ts) ═════════════════════════════════
# Fonctionne SANS AUCUNE CLÉ : vérification DNS réelle (DNS-over-HTTPS), unicité
# du domaine, et service du site sur le domaine du client en HTTP.
# Les 2 clés Cloudflare n'ajoutent que le HTTPS/CDN automatique (Cloudflare for SaaS).

# [ADMIN] Permission requise : « SSL and Certificates: Edit »
# CLOUDFLARE_API_TOKEN=
# [ADMIN] Zone qui héberge les custom hostnames (32 car. hex)
# CLOUDFLARE_ZONE_ID=
# [ADMIN] Cible CNAME annoncée aux clients. Défaut : cname.velbaz.site
# VELBAZ_DOMAIN_TARGET=
# [ADMIN] Domaine racine de l'hébergement. Défaut : velbaz.site
# VELBAZ_ROOT_DOMAIN=
# [ADMIN] Jeton d'un hébergeur externe. Sans lui, publication sur /s/:subdomain.
# VELBAZ_DEPLOY_TOKEN=

# ═══ ACHAT DE DOMAINE — registrar Namecheap ══════════════════════════════════
# La recherche de disponibilité (RDAP) marche sans clé. Les 4 sont requises
# ENSEMBLE ; sinon l'achat répond 501 en nommant les clés manquantes.

# [ADMIN] NAMECHEAP_API_USER=
# [ADMIN] NAMECHEAP_API_KEY=
# [ADMIN] NAMECHEAP_USERNAME=
# [ADMIN] IP du serveur, à autoriser dans les réglages API Namecheap
# NAMECHEAP_CLIENT_IP=

# ═══ SURVEILLANCE & AUTO-RÉPARATION — Sentry (api/selfheal/) ═════════════════
# Sans ces clés, l'auto-réparation retombe sur le flux interne (error_logs).

# [ADMIN] SENTRY_DSN=
# [ADMIN] Lecture des issues via l'API Sentry
# SENTRY_AUTH_TOKEN=
# [ADMIN] SENTRY_ORG=
# [ADMIN] SENTRY_PROJECT=
# [ADMIN] Seulement pour un Sentry auto-hébergé. Défaut : sentry.io
# SENTRY_API_URL=
# [ENV] Mettre à 1 pour désactiver l'auto-réparation
# SELFHEAL_DISABLED=

# ═══ EMAIL (api/email.ts) ════════════════════════════════════════════════════

# [ADMIN] RESEND_API_KEY=re_xxxxxxxx
# [ADMIN] RESEND_FROM=Velbaz <no-reply@ton-domaine.com>
# [ADMIN] Vérification des webhooks email entrants
# EMAIL_WEBHOOK_SECRET=

# ═══ GÉNÉRATION MÉDIA — Higgsfield (api/higgsfield.ts) ═══════════════════════

# [ADMIN] HF_API_KEY=
# [ADMIN] HF_API_SECRET=
# [ADMIN] Forme combinée alternative : key:secret
# HF_CREDENTIALS=
# [ENV] Replis historiques, lus seulement si les valeurs Admin Panel sont absentes
# HIGGSFIELD_KEY_ID=
# HIGGSFIELD_KEY_SECRET=
# HF_KEY=
# HF_SECRET=
# HF_BASE_URL=

# ═══ EXPORT GITHUB (api/github.ts) ═══════════════════════════════════════════

# [ADMIN] GITHUB_TOKEN=ghp_xxxxxxxx
# [ADMIN] GITHUB_OWNER=mon-org

# ═══ BUILDER & EXTRAS IA ═════════════════════════════════════════════════════

# [ENV] Composants React premium 21st.dev. Sans lui : composants générés maison.
# TWENTY_FIRST_API_KEY=
# [ENV] Scraping via Firecrawl. Sans lui : navigateur headless local.
# FIRECRAWL_API_KEY=
# [ENV] Routage OpenRouter (une clé « openrouter » dans le coffre suffit aussi).
# OPENROUTER_API_KEY=
# [ENV] Surcharges de modèles — défauts intégrés sinon
# AI_MODEL=
# IMAGE_MODEL=
# UNCENSORED_MODEL=
# TIER_MODEL_LITE=
# TIER_MODEL_PRO=
# TIER_MODEL_MAX=
# BUILDER_REPAIR_MODEL=
# SELFHEAL_MODEL=
# COMMS_REASONING_MODEL=
# [ENV] Taux de conversion crédits ↔ USD
# AI_CREDITS_PER_USD=

# ═══ PUBLICATION RÉSEAUX SOCIAUX (api/social/) ═══════════════════════════════
# Chaque plateforme reste désactivée jusqu'à ce que sa paire OAuth soit fournie.

# [ENV] DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# [ENV] INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# [ENV] REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# [ENV] TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# X_LIVE_ENABLED=
# [ENV] Base des URL de redirection OAuth + secret de signature du state
# OAUTH_REDIRECT_BASE=
# OAUTH_STATE_SECRET=

# ═══ ACCÈS BÊTA ══════════════════════════════════════════════════════════════

# [ENV] Code partagé. Défaut : VELBAZ-BETA
# BETA_PUBLIC_CODE=
# [ENV] BETA_ADMIN_CODE=
# [ENV] BETA_MAX_TESTERS=

# ═══ DIVERS / OPÉRATIONNEL ═══════════════════════════════════════════════════

# [ENV] Replis d'URL absolue (sinon WEBSITE_URL est utilisé)
# PUBLIC_BASE_URL=
# APP_BASE_URL=
# VELBAZ_URL=
# VELBAZ_API_URL=
# [ENV] Chemins et limites du builder
# VELBAZ_APPS_ROOT=
# CHIMERA_ASSETS_DIR=
# MAX_AUTO_RELAUNCH_PER_BOOT=
# DISABLE_SERVER_JSX=
